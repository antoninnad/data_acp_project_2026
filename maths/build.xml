<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="create_run_jar" name="Create Runnable Jar for Project PCA Face Recognition">
    <!--this file was created by Eclipse Runnable JAR Export Wizard-->
    <!--ANT 1.7 is required                                        -->
    <!--define folder properties-->
    <property name="dir.buildfile" value="."/>
    <property name="dir.workspace" value="${dir.buildfile}/.."/>
    <property name="dir.jarfile" value="${dir.buildfile}"/>
	<property name="dir.bindir" value="${dir.buildfile}/bin/"/>
	<property name="dir.docdir" value="${dir.buildfile}/doc/"/>
	<property name="dir.srcdir" value="${dir.buildfile}/src"/>
	<property name="dir.libdir" value="${dir.buildfile}/lib"/>
	<property name="jarfile" value="pcaman.jar"/>
	
	<!-- JavaFX libraries classpath -->
	<path id="javafx.classpath">
		<fileset dir="${dir.libdir}">
			<include name="javafx-*.jar"/>
		</fileset>
	</path>
	
	<target name="create_run_jar" depends="build">
        <jar destfile="${dir.jarfile}/${jarfile}" filesetmanifest="mergewithoutmain">
            <manifest>
                <attribute name="Main-Class" value="abstraction.PCA"/>
                <attribute name="Class-Path" value="."/>
            </manifest>
            <fileset dir="bin"/>
        </jar>
    </target>
		

	<!-- Delete files -->
	
	<target name="clean">
		<delete dir="${dir.bindir}"/>
		<delete dir="${dir.docdir}"/>		
	</target>
	
	
	<!-- Build - compiling the files -->
	
	<target name="build" depends="clean">
		<mkdir dir="${dir.bindir}" />
		<echo message="Compiling java files" />
		<javac srcdir="${dir.buildfile}/" destdir="${dir.bindir}" includeantruntime="false"/>
	</target>
	
	<!-- Run - executing the programm -->
	
	<target name="run" depends="build">
		<java jar="${dir.jarfile}/${jarfile}" fork="true">
			<jvmarg value="--module-path"/>
			<jvmarg value="${dir.libdir}"/>
			<jvmarg value="--add-modules"/>
			<jvmarg value="javafx.base,javafx.graphics,javafx.controls,javafx.fxml"/>
		</java>
	</target>
	

	<!-- Doc - generates the documentation -->
	<target name="doc">
		<mkdir dir="${dir.docdir}" />
		<javadoc sourcepath="${dir.buildfile}/" destdir="${dir.docdir}">
			<fileset dir="${dir.buildfile}/src" defaultexcludes="yes">
				<include name="**" />
			</fileset>
		</javadoc>
	</target>


	
	
	
</project>
